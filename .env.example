# Copia este archivo a .env (mismo directorio) y llena los valores reales.
# .env está en .gitignore -- nunca subas tokens ni credenciales reales aquí.

# Alerta de extract/detalle/monitoreo.py cuando un scraper detecta bloqueo o
# captcha repetido. Token del bot creado con @BotFather en Telegram.
TELEGRAM_BOT_TOKEN=

# ID del chat/usuario de Telegram al que llega la alerta.
TELEGRAM_CHAT_ID=
